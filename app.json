{
  "expo": {
    "name": "Sleep Detector",
    "slug": "detect-sleep",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sleepdetector.app",
      "buildNumber": "23",
      "jsEngine": "jsc",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Sleep Detector reads sleep records so it can avoid duplicating sleep periods in Apple Health.",
        "NSHealthUpdateUsageDescription": "Sleep Detector writes the sleep periods you record to Apple Health when you enable Health sync.",
        "NSUserNotificationsUsageDescription": "We send you notifications when sleep is detected and when you wake up with sleep summaries",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sleepdetector.app",
      "versionCode": 22,
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-3940256099942544~3347511713"
      },
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_CONTACTS"
      ]
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Sleep Detector reads sleep records so it can avoid duplicating sleep periods in Apple Health.",
          "NSHealthUpdateUsageDescription": "Sleep Detector writes the sleep periods you record to Apple Health when you enable Health sync.",
          "background": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2196F3"
        }
      ],
      [
        "expo-health-connect",
        {
          "healthConnectPermissions": [
            "READ_SLEEP",
            "WRITE_SLEEP"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c1f660d1-2639-4a53-9a69-0e3e3dd453fb"
      }
    },
    "owner": "retainr.io"
  }
}
